color = Color(0.86, 0.76, 0.52, 1)
polygon = PackedVector2Array(-64, -166, 64, -166, 58, -124, -58, -124)

[node name="Head" type="Polygon2D" parent="."]
material = SubResource("ShaderMaterial_flash")
color = Color(0.9, 0.83, 0.74, 1)
polygon = PackedVector2Array(-32, -304, 26, -312, 48, -288, 40, -256, 6, -246, -28, -254, -42, -282)

[node name="WeaponPivot" type="Node2D" parent="."]
position = Vector2(0, -170)

[node name="Blade" type="Polygon2D" parent="WeaponPivot"]
material = SubResource("ShaderMaterial_flash")
color = Color(0.85, 0.9, 0.95, 1)
polygon = PackedVector2Array(40, -12, 250, -4, 268, 0, 250, 4, 40, 12)

[node name="Hurtbox" type="Area2D" parent="."]
