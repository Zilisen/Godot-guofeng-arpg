[gd_scene load_steps=9 format=3]

; 玩家场景。占位美术按 docs/美术管线.md 的规格：
; 屏幕高约 300px @1080p、原点在脚底中心、统一朝右（正式版朝左用翻转）。

[ext_resource type="Script" path="res://scripts/actors/player.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/core/hitbox.gd" id="2_hitbox"]
[ext_resource type="Script" path="res://scripts/core/hurtbox.gd" id="3_hurtbox"]
[ext_resource type="Shader" path="res://assets/shaders/hit_flash.gdshader" id="4_flash"]
[ext_resource type="Resource" path="res://resources/attacks/light_1.tres" id="5_light1"]
[ext_resource type="Resource" path="res://resources/attacks/light_2.tres" id="6_light2"]
[ext_resource type="Resource" path="res://resources/attacks/light_3.tres" id="7_light3"]
[ext_resource type="Resource" path="res://resources/attacks/skill_whirl.tres" id="8_skill"]
[ext_resource type="Script" path="res://scripts/data/attack_data.gd" id="9_attackdata"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_flash"]
resource_local_to_scene = true
shader = ExtResource("4_flash")
shader_parameter/flash_amount = 0.0
shader_parameter/flash_color = Color(1, 1, 1, 1)

[sub_resource type="CircleShape2D" id="CircleShape2D_body"]
radius = 46.0

[sub_resource type="CircleShape2D" id="CircleShape2D_hurt"]
radius = 80.0

[sub_resource type="RectangleShape2D" id="RectangleShape2D_attack"]
size = Vector2(280, 190)

[node name="Player" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 1
motion_mode = 1
script = ExtResource("1_player")
combo = Array[ExtResource("9_attackdata")]([ExtResource("5_light1"), ExtResource("6_light2"), ExtResource("7_light3")])
skill = ExtResource("8_skill")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, -30)
shape = SubResource("CircleShape2D_body")

[node name="Body" type="Polygon2D" parent="."]
material = SubResource("ShaderMaterial_flash")
color = Color(0.72, 0.22, 0.24, 1)
polygon = PackedVector2Array(-58, -262, 58, -262, 78, -170, 66, -10, -66, -10, -78, -170)

[node name="Sash" type="Polygon2D" parent="."]
