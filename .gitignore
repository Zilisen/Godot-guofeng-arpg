# ---------- Godot 4 ----------
# 编辑器缓存与导入产物，必须忽略：它是本机生成物，体积大且随机器变化
.godot/
# 编辑器可能生成的临时导出配置
export.cfg
export_credentials.cfg
# Android 构建产物（以后加移动端再用）
/android/

# ---------- 出包产物 ----------
# Godot 的 export_path 指向这里，二进制不入库
build/
*.exe
*.pck
*.zip

# ---------- 系统 / 编辑器杂项 ----------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
.vscode/
.idea/
